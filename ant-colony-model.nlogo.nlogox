    <view x="790" wrappingAllowedX="true" y="5" frameRate="30.0" minPycor="-16" height="639" showTickCounter="true" patchSize="19.242424242424242" fontSize="10" wrappingAllowedY="true" width="639" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <button x="565" y="150" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="565" y="200" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="Go">go</button>
    <slider x="105" step="0.01" y="115" max="1" width="250" display="evaporation-rate" height="50" min="0" direction="Horizontal" default="0.05" variable="evaporation-rate"></slider>
    <slider x="105" step="1" y="175" max="200" width="250" display="number-of-ants" height="50" min="1" direction="Horizontal" default="100.0" variable="number-of-ants"></slider>
    <switch x="105" y="240" height="40" on="true" variable="show-pheromone?" width="200" display="show-pheromone?"></switch>
    <monitor x="10" precision="0" y="290" height="60" fontSize="11" width="175" display="Ants Carrying Food">count ants with [carrying-food?]</monitor>
    <monitor x="200" precision="0" y="290" height="60" fontSize="11" width="175" display="Ticks">ticks</monitor>
    <plot x="10" autoPlotX="true" yMax="30.0" autoPlotY="true" y="350" xMin="0.0" height="200" legend="false" xMax="100.0" yMin="0.0" width="750" display="Ants Carrying Food Over Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="ants carrying food" color="-2674135" legend="true">
        <setup></setup>
        <update>plot count ants with [carrying-food?]</update>
      </pen>
    </plot>
    <monitor x="385" precision="0" y="135" height="60" fontSize="11" width="100" display="Food Collected">food-collected</monitor>
    <monitor x="385" precision="1" y="225" height="60" fontSize="11" width="100" display="Avg Trip Time">average-trip-time</monitor>
    <chooser x="495" y="80" height="60" variable="world-mode" current="1" width="250" display="world-mode">
      <choice type="string" value="clear"></choice>
      <choice type="string" value="random-obstacles"></choice>
    </chooser>
    <slider x="495" step="1" y="15" max="40" width="250" display="number-of-obstacles" height="50" min="0" direction="Horizontal" default="38.0" variable="number-of-obstacles"></slider>
  </widgets>
