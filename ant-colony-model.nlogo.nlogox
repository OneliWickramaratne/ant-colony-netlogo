<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[breed [ants ant]

;; Global counters used by Member 5's data-collection code
globals [
  food-collected   ;; total food units delivered to the nest so far
  trip-times       ;; list of completed round-trip durations, in ticks
]

ants-own [
  carrying-food?    ;; true = returning to nest with food, false = searching
  trip-start-tick   ;; tick the ant last left the nest, used to time each trip
]

patches-own [
  nest?
  food?
  pheromone
  obstacle?
]

;; Initializes the whole model: world, ants, and Member 5's counters
to setup
  clear-all

  setup-world
  setup-ants

  set food-collected 0
  set trip-times []

  reset-ticks
end

;; Colours the world and marks out the nest and food regions
to setup-world
  ask patches [
    set pcolor green
    set nest? false
    set food? false
    set pheromone 0
    set obstacle? false
  ]

  ask patches with [distancexy 0 0 < 5] [
    set nest? true
    set pcolor brown
  ]

  ask patches with [distancexy 12 12 < 4] [
    set food? true
    set pcolor yellow
  ]
  
  ;; only runs if world-mode is switched to "random-obstacles" via the chooser
  if world-mode = "random-obstacles" [
    setup-obstacles
  ]

end

to setup-obstacles
  let placed 0
  while [placed < number-of-obstacles] [
    let cx random-pxcor
    let cy random-pycor
    let obstacle-radius 1 + random 2  

    let candidate-patches patches with [
      distancexy cx cy <= obstacle-radius
      and not nest? and not food?
    ]

    if any? candidate-patches [
      ask candidate-patches [
        set obstacle? true
        set pcolor gray
      ]
      set placed placed + 1
    ]
  ]
end

to setup-ants
  create-ants number-of-ants [
    set color red
    set size 1.5
    set carrying-food? false

    setxy 0 0
    set heading random 360
  ]
end

;; Movement Logic
;; Correlated random walk: small turn each tick, so movement looks natural
;; rather than jittery. Also steers ants back toward the centre near edges.
to random-search
  rt (random-float 30 - random-float 30)

  if abs xcor >= (max-pxcor - 1) or abs ycor >= (max-pycor - 1) [
    facexy 0 0
    rt (random-float 40 - 20)
  ]
  
  let ahead patch-ahead 1
  if ahead != nobody and [obstacle?] of ahead [
    rt 90 + random-float 90
  ]

  fd 1
end

;; Trail-following decision rule: while searching, compares pheromone on the
;; patch ahead, ahead-left, and ahead-right, then turns toward the strongest
;; one. Random noise keeps the choice probabilistic rather than robotic.
to follow-pheromone
  if not carrying-food? [
    let scent-ahead [pheromone] of patch-ahead 1
    let scent-left  [pheromone] of patch-left-and-ahead 45 1
    let scent-right [pheromone] of patch-right-and-ahead 45 1

    ;; only react if there's a meaningful trail nearby
    if (scent-ahead + scent-left + scent-right) > 0.1 [
      ifelse scent-right > scent-ahead and scent-right > scent-left [
        rt 45 + (random-float 30 - 15)
      ] [
        ifelse scent-left > scent-ahead and scent-left > scent-right [
          lt 45 + (random-float 30 - 15)
        ] [
          rt (random-float 20 - 10)
        ]
      ]
    ]
  ]
end

;; Records the tick an ant leaves the nest, so its trip length can be
;; measured later when it returns (Member 5's trip-time tracking)
to mark-departure
  if nest? and not carrying-food? [
    set trip-start-tick ticks
  ]
end

;; Picks up food if standing on a food patch and not already carrying any
to check-food
  if food? and not carrying-food? [
    set carrying-food? true
    set food? false
    set pcolor green
    rt 180
    set color yellow
  ]
end

;; Delivers food if standing on the nest while carrying it, and logs the
;; completed trip for Member 5's food-collected / trip-time monitors
to check-nest
  if nest? and carrying-food? [
    set carrying-food? false
    set food-collected food-collected + 1
    set trip-times lput (ticks - trip-start-tick) trip-times
    rt 180
    set color red
  ]
end

;; Deposits pheromone on the current patch while carrying food, marking
;; the return path so other ants can follow it later
to drop-pheromone
  if carrying-food? [
    set pheromone pheromone + 5
  ]
end

;; Decays pheromone on every patch each tick, and recolours patches to
;; visualise trail strength (toggle with show-pheromone?)
to evaporate
  ask patches [
    set pheromone pheromone * (1 - evaporation-rate)
    if not nest? and not food? and not obstacle? [
      ifelse show-pheromone? and pheromone > 0.5 [
        set pcolor scale-color blue pheromone 0 20
      ] [
        set pcolor green
      ]
    ]
  ]
end

;; Reports the average trip duration so far, or 0 if no trips completed yet
to-report average-trip-time
  ifelse length trip-times > 0
    [ report mean trip-times ]
    [ report 0 ]
end

;; Main per-tick scheduler: each ant runs its full behaviour cycle,
;; then the environment updates once
to go
  ask ants [
    mark-departure
    follow-pheromone
    random-search
    check-food
    check-nest
    drop-pheromone
  ]
  evaporate
  tick
end]]></code>
